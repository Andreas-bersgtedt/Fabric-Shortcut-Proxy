FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG FSP_EXTRAS=postgres,azureblob,keyvault,onelake,objectstore
ARG FSP_MODULE_PROFILE=default
ARG FSP_ENTERPRISE=1

RUN groupadd --gid 10001 fsp \
    && useradd --uid 10001 --gid fsp --create-home --home-dir /home/fsp fsp

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY enterprise/pyproject.toml ./enterprise/pyproject.toml
COPY enterprise ./enterprise

RUN python -m pip install --no-cache-dir ".[${FSP_EXTRAS}]" \
    && python -m pip install --no-cache-dir ./enterprise

COPY main.py ./
COPY module_registry.py ./
COPY enterprise ./enterprise

LABEL org.opencontainers.image.title="Fabric Shortcut Proxy Edge Lab" \
    io.fabric-shortcut-proxy.module-profile="${FSP_MODULE_PROFILE}" \
    io.fabric-shortcut-proxy.module-extras="${FSP_EXTRAS}"

USER 10001:10001
EXPOSE 9000
CMD ["python", "-m", "main"]
