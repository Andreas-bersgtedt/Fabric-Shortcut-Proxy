# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG FSP_EXTRAS=postgres
ARG PIP_INDEX_URL=https://pypi.org/simple

RUN groupadd --gid 10001 fsp \
    && useradd --uid 10001 --gid fsp --create-home --home-dir /home/fsp fsp

WORKDIR /app
COPY . .
RUN if [ -n "${FSP_EXTRAS}" ]; then \
        PIP_INDEX_URL="${PIP_INDEX_URL}" python -m pip install --no-cache-dir ".[${FSP_EXTRAS}]"; \
    else \
        PIP_INDEX_URL="${PIP_INDEX_URL}" python -m pip install --no-cache-dir .; \
    fi

USER 10001:10001
EXPOSE 9000
CMD ["python", "-m", "main"]
