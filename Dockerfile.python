# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG FSP_EXTRAS=postgres,azureblob,onelake
ARG FSP_ENTERPRISE=0
ARG FSP_INSTALL_MSSQL_ODBC=0
ARG PIP_INDEX_URL=https://pypi.org/simple

RUN if [ "${FSP_INSTALL_MSSQL_ODBC}" = "1" ]; then \
        apt-get update; \
        apt-get install -y --no-install-recommends curl gnupg unixodbc; \
        curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
            | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg; \
        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
            > /etc/apt/sources.list.d/microsoft-prod.list; \
        apt-get update; \
        ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18; \
        rm -rf /var/lib/apt/lists/*; \
    fi

RUN groupadd --gid 10001 fsp \
    && useradd --uid 10001 --gid fsp --create-home --home-dir /home/fsp fsp

WORKDIR /app
COPY . .
RUN if [ -n "${FSP_EXTRAS}" ]; then \
        PIP_INDEX_URL="${PIP_INDEX_URL}" python -m pip install --no-cache-dir ".[${FSP_EXTRAS}]"; \
    else \
        PIP_INDEX_URL="${PIP_INDEX_URL}" python -m pip install --no-cache-dir .; \
    fi \
    && if [ "${FSP_ENTERPRISE}" = "1" ]; then \
        PIP_INDEX_URL="${PIP_INDEX_URL}" python -m pip install --no-cache-dir ./enterprise; \
    fi

USER 10001:10001
EXPOSE 9000
CMD ["python", "-m", "main"]
