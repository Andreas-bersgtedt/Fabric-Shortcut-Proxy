{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "images",
    "fsp",
    "sourceSecret",
    "agentAuth",
    "workloadIdentity",
    "storage",
    "manager",
    "materializer",
    "cppAgent",
    "nginx",
    "tls",
    "networkPolicy"
  ],
  "properties": {
    "managerUrl": { "type": "string", "minLength": 1 },
    "siteId": { "type": "string", "maxLength": 32, "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$" },
    "agentPoolId": { "type": "string", "maxLength": 63, "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$" },
    "agentLocation": { "type": "string", "maxLength": 63, "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$" },
    "agentControlIngress": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "pathPrefix": { "type": "string", "pattern": "^(/[A-Za-z0-9_-]+)*$" },
        "className": { "type": "string", "minLength": 1 },
        "tlsSecretName": { "type": "string", "minLength": 1 },
        "clusterIssuer": { "type": "string" },
        "sourceRanges": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressController",
        "metricsScraper",
        "ingressCidrs",
        "managerEgress",
        "servingAgentEgress"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "podSelector": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "metricsScraper": {
          "type": "object",
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "podSelector": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ingressCidrs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "managerEgress": {
          "type": "object",
          "required": ["allowList"],
          "properties": {
            "allowList": { "$ref": "#/definitions/networkAllowList" }
          }
        },
        "servingAgentEgress": {
          "type": "object",
          "required": ["managerCidrs", "managerPort", "allowList"],
          "properties": {
            "managerCidrs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "managerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "allowList": { "$ref": "#/definitions/networkAllowList" }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "images": {
      "type": "object",
      "required": ["pullPolicy", "pullSecrets", "python", "cpp", "nginx"],
      "properties": {
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "python": { "$ref": "#/definitions/image" },
        "cpp": { "$ref": "#/definitions/image" },
        "nginx": { "$ref": "#/definitions/image" }
      }
    },
    "fsp": {
      "type": "object",
      "required": ["s3Bucket", "materializeMode", "requireSigV4", "authMode"],
      "properties": {
        "s3Bucket": { "type": "string", "minLength": 1 },
        "artifactStoreBackend": { "type": "string" },
        "artifactStoreDir": { "type": "string" },
        "artifactStoreServing": { "type": "string" },
        "artifactStoreAccountUrl": { "type": "string" },
        "artifactStoreContainer": { "type": "string" },
        "artifactStoreAuthMode": { "enum": ["managed_identity", "workload_identity", "default"] },
        "artifactStoreClientId": { "type": "string" },
        "artifactStoreTenantId": { "type": "string" },
        "artifactStoreTokenFile": { "type": "string" },
        "materializeMode": { "enum": ["eager", "lazy", "virtual"] },
        "shardStrategy": { "type": "string" },
        "materializeWaitSeconds": { "type": "string" },
        "generationSourceConsistency": { "type": "string" },
        "generationMembershipPolicy": { "enum": ["fixed", "elastic"] },
        "snapshotMaxLifetimeSeconds": { "type": "string" },
        "streamingParquet": { "type": "string" },
        "streamBatchRows": { "type": "string" },
        "sourceMaxConcurrency": { "type": "string" },
        "maxConcurrentGenerations": { "type": "string" },
        "pinMaterializedSplits": { "type": "string" },
        "requireSigV4": { "enum": ["0", "1"] },
        "authMode": { "type": "string" },
        "keyVaultUri": { "type": "string" },
        "keyVaultWriteBack": { "enum": ["0", "1"] },
        "azureTenantId": { "type": "string" },
        "azureClientId": { "type": "string" }
      }
    },
    "sourceSecret": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "agentAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "secretName",
        "activeTokenKey",
        "previousTokenKey",
        "previousValidUntilKey"
      ],
      "properties": {
        "mode": { "enum": ["required", "compatibility", "entra"] },
        "secretName": { "type": "string", "minLength": 1 },
        "activeTokenKey": { "type": "string", "minLength": 1 },
        "previousTokenKey": { "type": "string", "minLength": 1 },
        "previousValidUntilKey": { "type": "string", "minLength": 1 },
        "identityTokensSecretName": { "type": "string" },
        "identityTokensKey": { "type": "string", "minLength": 1 },
        "entra": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "audience", "identities"],
          "properties": {
            "tenantId": { "type": "string" },
            "audience": { "type": "string" },
            "identities": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["client_id", "principal_id"],
                "properties": {
                  "client_id": { "type": "string", "format": "uuid" },
                  "principal_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "required": ["enabled", "serviceAccountName", "clientId"],
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "clientId": { "type": "string" }
      }
    },
    "nodeSelector": { "type": "object" },
    "storage": {
      "type": "object",
      "required": ["artifacts", "azureFiles"],
      "properties": {
        "artifacts": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size": { "$ref": "#/definitions/quantity" },
            "storageClassName": { "type": ["string", "null"] },
            "existingVolumeName": { "type": "string" }
          }
        },
        "azureFiles": {
          "type": "object",
          "required": ["enabled", "artifacts", "managerConfig"],
          "properties": {
            "enabled": { "type": "boolean" },
            "resourceGroup": { "type": "string" },
            "storageAccount": { "type": "string" },
            "protocol": { "type": "string" },
            "encryptInTransit": { "enum": ["true", "false"] },
            "reclaimPolicy": { "enum": ["Retain", "Delete", "Recycle"] },
            "mountOptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "artifacts": { "$ref": "#/definitions/share" },
            "managerConfig": {
              "allOf": [
                { "$ref": "#/definitions/share" },
                {
                  "type": "object",
                  "required": ["size"],
                  "properties": {
                    "size": { "$ref": "#/definitions/quantity" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "manager": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["operatorSecretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "operatorSecretName": { "type": "string", "minLength": 1 },
            "agentPlacementConfig": {
              "type": "object",
              "additionalProperties": true
            },
            "artifactStoreProfile": { "type": "string" }
          }
        }
      ]
    },
    "materializer": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["autoscaling"],
          "properties": {
            "enabled": { "type": "boolean" },
            "egress": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "allowLocalManager": { "type": "boolean" },
                "managerCidrs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "managerPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "allowList": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["cidr", "ports"],
                    "properties": {
                      "name": { "type": "string" },
                      "cidr": { "type": "string", "minLength": 1 },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        }
                      }
                    }
                  }
                }
              }
            },
            "autoscaling": {
              "type": "object",
              "required": [
                "enabled",
                "minReplicas",
                "maxReplicas",
                "targetCpuUtilization",
                "scaleDownStabilizationSeconds"
              ],
              "properties": {
                "enabled": { "type": "boolean" },
                "minReplicas": { "type": "integer", "minimum": 1 },
                "maxReplicas": { "type": "integer", "minimum": 1 },
                "targetCpuUtilization": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "scaleDownStabilizationSeconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "cppAgent": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": [
            "autoscaling",
            "disruptionBudget",
            "materializeTimeoutMs",
            "s3AuthMode",
            "s3AuthSecretName",
            "s3AccessKeyIdKey",
            "s3SecretAccessKeyKey",
            "s3AllowedPrefixes"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "materializeTimeoutMs": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "s3AuthMode": { "enum": ["sigv4", "trusted-upstream"] },
            "s3AuthSecretName": { "type": "string", "minLength": 1 },
            "s3AccessKeyIdKey": { "type": "string", "minLength": 1 },
            "s3SecretAccessKeyKey": { "type": "string", "minLength": 1 },
            "s3AllowedPrefixes": { "type": "string" }
          }
        }
      ]
    },
    "nginx": {
      "allOf": [
        { "$ref": "#/definitions/workload" },
        {
          "type": "object",
          "required": ["enabled", "certificateSecretName", "privateService"],
          "properties": {
            "enabled": { "type": "boolean" },
            "certificateSecretName": { "type": "string", "minLength": 1 },
            "privateService": {
              "type": "object",
              "required": ["enabled", "subnet", "ipAddress"],
              "properties": {
                "enabled": { "type": "boolean" },
                "subnet": { "type": "string" },
                "ipAddress": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "tls": {
      "type": "object",
      "required": ["enabled", "hostname", "clusterIssuer", "ingress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string" },
        "clusterIssuer": {
          "type": "object",
          "required": ["create", "name", "acmeServer", "email"],
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "acmeServer": { "type": "string", "format": "uri" },
            "email": { "type": "string" }
          }
        },
        "ingress": {
          "type": "object",
          "required": ["className"],
          "properties": {
            "className": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "networkAllowList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "ports"],
        "properties": {
          "cidr": { "type": "string", "minLength": 1 },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "quantity": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)?$"
    },
    "share": {
      "type": "object",
      "required": ["shareName", "volumeHandle"],
      "properties": {
        "shareName": { "type": "string", "minLength": 1 },
        "volumeHandle": { "type": "string" }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "type": "object" },
            "limits": { "type": "object" }
          }
        }
      }
    }
  }
}
